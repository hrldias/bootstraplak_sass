{#
/**
 * @file
 * Better Login theme implementation to display a registration page.
 *
 *
 * Available variables:
 *
 * General utility variables:
 * - url: The base URL path of the Drupal website.
 * - logo: Logo path of Drupal website.
 * - site_name: Site name of Drupal website.
 * - title: Title of a page.
 *
 * Regions:
 * - page.highlighted: Items for the highlighted region.
 * - page.content: The main content of the current page.
 *
 * @see betterlogin_preprocess_betterlogin()
 */
#}
{% block head %}
      {% if page.secondary_menu or page.top_header or page.top_header_form %}
        <nav{{ navbar_top_attributes }}>
          {% if container_navbar %}
          <div class="container">
          {% endif %}
            {{ page.secondary_menu }}
            {{ page.top_header }}
            {% if page.top_header_form %}
              <div class="form-inline navbar-form ms-auto">
                {{ page.top_header_form }}
              </div>
            {% endif %}
          {% if container_navbar %}
          </div>
          {% endif %}
        </nav>
      {% endif %}

      {% if page.header or page.primary_menu or page.header_form %}
        <header id="header" class="header sticky-top header-main" role="banner" aria-label="{{ 'Site header'|t}}">
          <nav class="navbar sticky-top navbar-expand-lg navbar-light">
            <div class="container-lg">
               <div id="knavbar-togler">
	              <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar" aria-expanded="false" aria-label="Toggle navigation">
		            <span class="navbar-toggler-icon"></span>
	              </button>
	              <span class="menu-icon-text">{{ page.menu_togglet_text }}</span>
               </div>
              {{ page.header }}

              {% if page.primary_menu %}
               <div class="collapse navbar-collapse justify-content-center" id="navbarNav"> 
                  {{ page.primary_menu }}
               </div>
              {% endif %}

              
              {% if page.header_form %}
                <div class="d-flex">
                  {{ page.header_form }}
                  
                </div>
              {% endif %}
             {% include "@bootstrap_sass/includes/lak-user-menu.html.twig" %}
              
              
            
            </div>
          </nav>
            <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
              <div class="offcanvas-header">
                <span class="offcanvas-logo">{% if page.offcanves_logo %} {{ page.offcanves_logo }} {% endif %}</span>
                <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
              </div>
              <div class="offcanvas-body">
                {% if page.offcanves_menu %}
                  <div class="lak-offcnvs"> {{ page.offcanves_menu }} </div>
                {% endif %}

                {% if logged_in %}
                 <ul class="nav flex-column">
                 <li class="nav-item"><hr></li>
                 <li class="nav-item offcanvas-logout-btn"> <a href="{{ path('user.logout') }}" class=" text-danger fw-semibold" > Log Out </a></li>
                 </ul>
                {% endif %}
              </div>
            </div>

        </header>
      {% endif %}

{% endblock %}



<div id="auth_box2" class="register">

  <div id="middle_part">
    <center><h2 class="title">{{ title }}</h2></center>

    {{ page.highlighted }}

    {{ messages }}

    {{ page.content }}
  </div>

  <div id="bottom_part">
    <div class="login_link">
      <a href="{{ path('user.login') }}">{{ 'Login'|t }}</a>
    </div>

    <div class="password_link">
      <a href="{{ path('user.pass') }}">{{ 'Forgot your password?'|t }}</a>
    </div>

  </div>
</div>
