

<div class="ad-card-1 border border-2 rounded-3 m-2 mb-3 px-3 pb-2 mx-auto">
        <div class="d-flex my-2 align-items-center gap-2">
            {% if node.field_co_top_ad.value == '1' %} <div class="sld-badge-top badge">{{ 'Top Ad'|t }}</div>{% endif %}
            {% if node.field_co_id_verified.value == '1' %} <div class="sld-badge-id badge">{{ 'ID Verified'|t }}</div>{% endif %}
            <div class="flex-grow-1"></div>
            <div class=""><strong>{{ 'Ad No:'|t }} {{ content.field_co_webform_submission_id }}</strong></div>
        </div>
        <div class="d-flex flex-column flex-md-row mt-4 gap-3">
            <div class="ad-card-image text-center mx-auto mx-md-0">
                     {% if not node.field_co_display_image.isEmpty() %}
                         <div> {{ content.field_co_display_image }} </div>
                         <div> 
                             <p class="text-center fst-italic fw-bol "> {{ 'Click'|t }} <span class="icon icon-hand-pointer"></span> </p>         
                         </div>
                     {% else %}
                           <div>  <a> <img src="/sites/default/files/no-image.jpg" class="rounded-4"> </a>   </div> 
                     {% endif %}
            </div>
            <div class="flex-grow-1">
                <table class="table table-sm ">
                    <tbody>
                        <tr>
                            <th scope="row">{{ 'Name'|t }}</th>
                            <td>:</td>
                            <td> {{ content.field_co_display_name }} </td>
                        </tr>
                        <tr>
                            <th scope="row">{{ 'Gender'|t }}</th>
                            <td>:</td>
                            <td> {{ content.field_co_gender }} </td>
                        </tr>
                        <tr>
                            <th scope="row">{{ 'Birthday'|t }}</th>
                            <td>:</td>
                            <td> {{ content.field_co_birth_day }} </td>
                        </tr>
                        <tr>
                            <th scope="row">{{ 'Civil Status'|t }}</th>
                            <td>:</td>
                            <td> {{ content.field_co_civil_status }} </td>
                        </tr>
                        <tr>
                            <th scope="row">{{ 'Height'|t }}</th>
                            <td>:</td>
                            <td>
                                {% set total_in = node.field_co_height_calc_in.value %}
                                {% if total_in is not empty and total_in > 0 %}
                                    {% set feet = (total_in / 12)|round(0, 'floor') %}
                                    {% set rem_in = total_in % 12 %}
                                    {{ feet }}' {{ rem_in }}"
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th scope="row">{{ 'Ethnicity'|t }}</th>
                            <td>:</td>
                            <td> {{ content.field_co_ethnity }} </td>
                        </tr>
                        <tr>
                            <th scope="row">{{ 'Religion'|t }}</th>
                            <td>:</td>
                            <td> {{ content.field_co_religion }} </td>
                        </tr>
                        <tr>
                            <th scope="row">{{ 'Horoscope Matching'|t }}</th>
                            <td>:</td>
                            <td> {{ content.field_co_horoscope_matching }} </td>
                        </tr>
                        <tr>
                            <th scope="row">{{ 'Caste'|t }}</th>
                            <td>:</td>
                            <td> {{ content.field_co_caste }} </td>
                        </tr>
                        <tr>
                            <th scope="row">{{ 'Living Country'|t }}</th>
                            <td>:</td>
                            <td>
                                {% set country_term = node.field_co_currently_living_countr.entity %}
                                {% if country_term %}
                                    {% set iso2 = country_term.field_iso2.value|default('')|lower %}
                                    {% set country_name = country_term.label %}
                                    <span class="country-with-flag">
                                        <img
                                            src="/sites/default/files/flags/h40/{{ iso2 }}.png"
                                            width="40"
                                            alt="{{ country_name }}"
                                        />
                                        {{ country_name }}
                                    </span>
                                {% else %}
                                    {{ content.field_co_currently_living_countr }}
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th scope="row">{{ 'District'|t }}</th>
                            <td>:</td>
                            <td> {{ content.field_co_district }} </td>
                        </tr>
                        <tr>
                            <th scope="row">{{ 'Town'|t }}</th>
                            <td>:</td>
                            <td> {{ content.field_co_town }} </td>
                        </tr>
                        <tr>
                            <th scope="row">{{ 'Education Qualification'|t }}</th>
                            <td>:</td>
                            <td> {{ content.field_co_edu_qualification }} </td>
                        </tr>
                        <tr>
                            <th scope="row">{{ 'Work Sector'|t }}</th>
                            <td>:</td>
                            <td> {{ content.field_co_work_sector }} </td>
                        </tr>
                        <tr>
                            <th scope="row">{{ 'Profession'|t }}</th>
                            <td>:</td>
                            <td>
                                {% set profession_term = node.field_co_profession.entity %}
                                {% if profession_term and 'Other ...' in profession_term.name.value %}
                                    {{ content.field_co_profession_other }}
                                {% else %}
                                    {{ content.field_co_profession }}
                                {% endif %}
                            </td>
                        </tr>
                    </tbody>
                </table>

            </div>
        </div>

        <div>
            <div><strong>{{ 'Description:'|t }}</strong></div>
            <div> {{ content.field_co_short_description }} </div>
        </div>
        <div class="adcard-publish-date"><strong>{{ 'Published On :'|t }}</strong> {{ node.created.value|date('Y M d') }}  </div>
    </div>



{{ attach_library('core/drupal.dialog.ajax') }}






