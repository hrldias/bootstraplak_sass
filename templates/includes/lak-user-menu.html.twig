

{% if logged_in %}

  
  <div class="dropstart"> 
    <button class="usernm dropdown-toggle" data-bs-toggle="dropdown" type="button" aria-expanded="false">
     {{ current_user_name|slice(0,2)|upper }}
    </button>
  
      <ul class="dropdown-menu " data-bs-popper="static">
        {{ page.user_account_menu }}
        <li><hr class="dropdown-divider"></li>
        <li class="dropdown-item"> <a href="{{ path('user.logout') }}" class="text-danger fw-semibold" > Log Out </a></li>
      </ul>
  </div>

{% else %}
   <a class="nav-link--user-login" href="/user/login" class="">Log in</a>
{% endif %}
